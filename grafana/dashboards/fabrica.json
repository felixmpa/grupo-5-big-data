    {
      "type": "table",
      "title": "Historial de alertas",
      "description": "Momentos en que una máquina pasó de 'sin alerta' a 'alerta' en el rango de tiempo elegido.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"predicciones\")\n  |> filter(fn: (r) => r._field == \"alerta\" or r._field == \"riesgo\" or r._field == \"estado_predicho\" or r._field == \"estado_real\")\n  |> filter(fn: (r) => r.maquina_id =~ /^${maquina:regex}$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({r with en_alerta: if r.alerta then 1 else 0}))\n  |> difference(columns: [\"en_alerta\"])\n  |> filter(fn: (r) => r.en_alerta == 1)\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)\n  |> map(fn: (r) => ({_time: r._time, maquina: r.maquina_id, riesgo: r.riesgo * 100.0,\n                      predicho: r.estado_predicho, real: r.estado_real}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "normal": {
                  "text": "Normal",
                  "color": "#0ca30c",
                  "index": 0
                },
                "degradacion": {
                  "text": "Degradación",
                  "color": "#fab219",
                  "index": 1
                },
                "falla": {
                  "text": "Falla",
                  "color": "#d03b3b",
