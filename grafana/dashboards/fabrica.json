{
  "uid": "fabrica",
  "title": "Fábrica – Mantenimiento predictivo",
  "description": "Sensores IoT, riesgo de falla y anomalías por máquina (Grupo 5).",
  "tags": [
    "iot",
    "big-data",
    "mantenimiento-predictivo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "maquina",
        "label": "Máquina",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"sensores\", tag: \"maquina_id\", predicate: (r) => r._measurement == \"lecturas\", start: -1h)",
        "definition": "maquina_id (tag)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Riesgo de falla ahora (por máquina)",
      "description": "Probabilidad de degradación + falla según el modelo (último valor). Rojo = alerta (≥ 50 %).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 14,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"sensores\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"predicciones\" and r._field == \"riesgo\")\n  |> filter(fn: (r) => r.maquina_id =~ /^${maquina:regex}$/)\n  |> last()\n  |> map(fn: (r) => ({r with _value: r._value * 100.0}))\n  |> keep(columns: [\"_time\", \"_value\", \"maquina_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.maquina_id}",
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Máquinas en alerta",
      "description": "Cuántas máquinas tienen riesgo ≥ 50 % en este momento.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"sensores\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"predicciones\" and r._field == \"alerta\")\n  |> filter(fn: (r) => r.maquina_id =~ /^${maquina:regex}$/)\n  |> last()\n  |> map(fn: (r) => ({r with _value: if r._value then 1 else 0}))\n  |> group()\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "en alerta",
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Lecturas por minuto",
      "description": "Lecturas que llegaron a InfluxDB en el último minuto, sumando todas las máquinas.",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"sensores\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"lecturas\" and r._field == \"temperatura\")\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "lecturas / min",
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 3
    },
    {
      "type": "state-timeline",
      "title": "Estado según el modelo",
      "description": "Estado más probable según el Random Forest (predictor.py).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"sensores\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"predicciones\" and r._field == \"estado_predicho\")\n  |> filter(fn: (r) => r.maquina_id =~ /^${maquina:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"maquina_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.maquina_id}",
          "mappings": [
            {
              "type": "value",
              "options": {
                "normal": {
                  "text": "Normal",
                  "color": "#0ca30c",
                  "index": 0
                },
                "degradacion": {
                  "text": "Degradación",
                  "color": "#fab219",
                  "index": 1
                },
                "falla": {
                  "text": "Falla",
                  "color": "#d03b3b",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "insertNulls": 60000
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 4
    },
    {
